; KS.INF

; Installation of Audio / Video Adapters

[Version]
Signature  = "$Windows NT$"
;Signature  = "$Tavera$"
LayoutFile = layout.inf
Class      = MEDIA
ClassGUID  = {4d36e96c-e325-11ce-bfc1-08002be10318}
Provider   = %Tavera OS%
DriverVer  = 10/19/1999,5.00.2157.1

[KS.Registration]
AddReg=ProxyRegistration, TopologyRegistration, PlugRegistration, PinRegistration, AudRegistration
CopyFiles=KSProxy.Files, KSDriver.Files

[Stream.Registration]
CopyFiles=StreamDriver.Files

[DestinationDirs]
DefaultDestDir=11
KSProxy.Files=11
KSDriver.Files=10,system32\drivers
KSProxy.DelFiles=11
StreamDriver.Files=10,system32\drivers

[ProxyRegistration]
HKCR,%Proxy.FilterId%,,,%Proxy.FilterDesc%
HKCR,%Proxy.FilterId%\InprocServer32,,,ksproxy.ax
HKCR,%Proxy.FilterId%\InprocServer32,ThreadingModel,,Both

[KSDriver.Files]
ks.sys

[StreamDriver.Files]
stream.sys

[KSProxy.Files]
ksuser.dll
;ksproxy.ax

